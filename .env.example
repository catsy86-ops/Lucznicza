# ===== Environment Configuration Template =====
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to repository
# NEVER share .env files or API keys

# ===== Application Settings =====
NODE_ENV=development
APP_NAME=Niebuszewo Guide
APP_VERSION=2.0.0
APP_URL=http://localhost:3000

# ===== Server Configuration =====
PORT=3000
HOST=localhost
DEBUG=false

# ===== Google Maps API (Optional) =====
# Get your API key from: https://console.cloud.google.com
# Enable: Maps JavaScript API, Street View Static API
GOOGLE_MAPS_API_KEY=your_api_key_here

# ===== Weather API (Open-Meteo - Free, No Key Required) =====
# Open-Meteo is free and doesn't require API keys
WEATHER_API_URL=https://api.open-meteo.com

# ===== Air Quality API (Open-Meteo - Free) =====
AIR_QUALITY_API_URL=https://air-quality-api.open-meteo.com

# ===== Database (if needed) =====
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# SQLITE_PATH=./data/app.db

# ===== Authentication (if needed) =====
# JWT_SECRET=your_super_secret_jwt_key_min_32_chars
# JWT_EXPIRY=7d
# OAUTH_CLIENT_ID=your_oauth_client_id
# OAUTH_CLIENT_SECRET=your_oauth_client_secret

# ===== Email Service (if needed) =====
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=noreply@niebuszewoguide.pl

# ===== Third-party Services =====
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# ANALYTICS_KEY=your_analytics_key

# ===== File Upload (if needed) =====
# MAX_FILE_SIZE=5242880
# UPLOAD_DIR=./uploads
# ALLOWED_EXTENSIONS=jpg,png,pdf,xlsx

# ===== Logging =====
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# ===== Security =====
# CORS_ORIGIN=http://localhost:3000,https://example.com
# RATE_LIMIT=100

# ===== Feature Flags =====
ENABLE_DARK_MODE=true
ENABLE_MOBILE_OPTIMIZATIONS=true
ENABLE_ANALYTICS=false
ENABLE_HAPTIC_FEEDBACK=true

# ===== Debug Mode =====
# Set to true only in development
DEBUG_MODE=false
VERBOSE_LOGGING=false

# ===== Session Configuration (if needed) =====
# SESSION_SECRET=your_session_secret_key
# SESSION_MAX_AGE=86400000

# ===== Redis (if needed) =====
# REDIS_URL=redis://localhost:6379
# REDIS_DB=0

# ===== Vercel/Hosting =====
# VERCEL_URL is automatically set by Vercel
# VERCEL_ENV=development

# ===== Custom Configuration =====
# Add your custom variables below
# CUSTOM_SETTING=value
